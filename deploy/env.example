# VPS /etc/lianhuan.env
# 安装默认管理员（首次进后台请改密，仅提示不强制）：
#   邮箱 admin@lianhuan.local
#   密码 admin123
LIANHUAN_SECRET=请换成随机长字符串
LIANHUAN_ADMIN_EMAIL=admin@lianhuan.local
LIANHUAN_ADMIN_PASSWORD=admin123
LIANHUAN_PORT=8092
LIANHUAN_RELEASES_DIR=/opt/lianhuan/releases
LIANHUAN_RELEASES_REPO=https://github.com/e12games/facefusion-releases.git
# 私有 GitHub 主仓时填写（公开 facefusion-releases 不需要）
# GITHUB_TOKEN=
# TRONGRID_API_KEY=
